# ==========================================================
# Plateforme BTP — variables d'environnement
# Copier vers .env.local (jamais committe) et renseigner.
# ==========================================================

# --- Base de donnees Neon ---
# Console Neon > projet location-btp > Connection string (pooled)
DATABASE_URL=

# --- Authentification (lot B) ---
# Generer avec : openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Application ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
