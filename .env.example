# ==========================================================
# Copier vers .env.local, puis renseigner.
# .env.local n'est JAMAIS versionne.
# ==========================================================

# Chaine de connexion PostgreSQL.
#
# Production — Neon, console > projet location-btp > Connection string,
# version "pooled". N'utiliser QUE le parametre ?sslmode=require :
# coller une chaine contenant un & la fait couper par Vercel.
#   DATABASE_URL=postgresql://user:motdepasse@ep-xxx.eu-central-1.aws.neon.tech/btp?sslmode=require
#
# Developpement local — un PostgreSQL classique suffit, le pilote
# est choisi automatiquement d'apres l'hote.
#   DATABASE_URL=postgresql://postgres@127.0.0.1:5432/btp
DATABASE_URL=
